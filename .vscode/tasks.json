{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "cmake --build build -j",
      "dependsOn": ["Configure Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Configure Release",
      "type": "shell",
      "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "cmake --build build-release -j",
      "dependsOn": ["Configure Release"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean Debug",
      "type": "shell",
      "command": "cmake --build build --target clean"
    },
    {
      "label": "Run Debug",
      "type": "shell",
      "command": "./build/alpha_hist_app",
      "dependsOn": ["Build Debug"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Run gen_synth (Debug)",
      "type": "shell",
      "command": "./build/gen_synth data/png",
      "dependsOn": ["Build Debug"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Run test_alpha_blend (Debug)",
      "type": "shell",
      "command": "./build/test_alpha_blend data/png data/tests/blend_results 1.0 over scalar",
      "dependsOn": ["Build Debug"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Run test_histogram (Debug)",
      "type": "shell",
      "command": "./build/test_histogram data/png data/tests/hist_results scalar",
      "dependsOn": ["Build Debug"],
      "options": { "cwd": "${workspaceFolder}" }
    }
  ]
}
