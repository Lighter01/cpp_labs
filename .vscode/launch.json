{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug alpha_hist_app (WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/alpha_hist_app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "stopAtEntry": false,
      "externalConsole": false,

      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",

      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug test_alpha_blend (WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test_alpha_blend",
      "args": ["data/png", "data/tests/blend_results", "1.0", "over", "scalar"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug test_histogram (WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test_histogram",
      "args": ["data/png", "data/tests/hist_results", "scalar"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
